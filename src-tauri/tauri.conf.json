{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "我密码呢",
  "version": "0.4.0",
  "identifier": "fm.castbox.account-notebook",
  "build": {
    "beforeDevCommand": "cmd /c npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "cmd /c npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "我密码呢",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http:"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
